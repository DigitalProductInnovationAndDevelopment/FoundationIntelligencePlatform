# Copy to frontend/.env. VITE_* values are bundled into client code and are not secrets.
# By default the UI uses its current browser hostname on port 8000. Override only
# when the API genuinely runs elsewhere; mixing localhost and 127.0.0.1 breaks cookies.
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Authentication is handled by the deployment OIDC flow. Never add credentials
# or shared secrets to VITE_* variables because they are bundled into JavaScript.
