{
  "configuration_version": "1",
  "service": "foundation-intelligence-api",
  "expected_schema_version": "0006_governance_retention",
  "metrics": [
    {"name": "readiness_success", "type": "gauge", "unit": "None", "dimensions": ["service", "environment"]},
    {"name": "api_request_duration_ms", "type": "histogram", "unit": "Milliseconds", "dimensions": ["service", "environment", "operation", "status"]},
    {"name": "api_errors_total", "type": "counter", "unit": "Count", "dimensions": ["service", "environment", "operation", "error_class"]},
    {"name": "db_pool_checked_out", "type": "gauge", "unit": "Count", "dimensions": ["service", "environment"]},
    {"name": "db_pool_utilization_ratio", "type": "gauge", "unit": "None", "dimensions": ["service", "environment"]},
    {"name": "query_duration_ms", "type": "histogram", "unit": "Milliseconds", "dimensions": ["service", "environment", "operation"]},
    {"name": "cache_hit_ratio", "type": "gauge", "unit": "None", "dimensions": ["service", "environment", "cache"]},
    {"name": "dataset_age_seconds", "type": "gauge", "unit": "Seconds", "dimensions": ["service", "environment", "dataset_version"]},
    {"name": "source_freshness_seconds", "type": "gauge", "unit": "Seconds", "dimensions": ["service", "environment", "source"]},
    {"name": "pipeline_duration_ms", "type": "histogram", "unit": "Milliseconds", "dimensions": ["service", "environment", "job_type", "status"]},
    {"name": "pipeline_failures_total", "type": "counter", "unit": "Count", "dimensions": ["service", "environment", "job_type", "error_class"]},
    {"name": "pipeline_record_count", "type": "gauge", "unit": "Count", "dimensions": ["service", "environment", "source", "result"]},
    {"name": "reconciliation_mismatch_count", "type": "gauge", "unit": "Count", "dimensions": ["service", "environment", "dataset_version"]},
    {"name": "conversion_gap_count", "type": "gauge", "unit": "Count", "dimensions": ["service", "environment", "dataset_version"]},
    {"name": "programme_coverage_ratio", "type": "gauge", "unit": "None", "dimensions": ["service", "environment", "dataset_version"]},
    {"name": "geography_coverage_ratio", "type": "gauge", "unit": "None", "dimensions": ["service", "environment", "dataset_version"]},
    {"name": "queue_oldest_message_age_seconds", "type": "gauge", "unit": "Seconds", "dimensions": ["service", "environment", "queue"]},
    {"name": "dlq_depth", "type": "gauge", "unit": "Count", "dimensions": ["service", "environment", "queue"]},
    {"name": "worker_failures_total", "type": "counter", "unit": "Count", "dimensions": ["service", "environment", "worker", "error_class"]},
    {"name": "task_restarts_total", "type": "counter", "unit": "Count", "dimensions": ["service", "environment", "task_family"]},
    {"name": "estimated_cost_usd", "type": "gauge", "unit": "None", "dimensions": ["environment", "service_category"]}
  ],
  "alarms": [
    {"name": "readiness-failure", "metric": "readiness_success", "comparison": "LessThanThreshold", "threshold": 1, "evaluation_periods": 2, "period_seconds": 60, "runbook": "readiness-failure"},
    {"name": "api-5xx-budget", "metric": "api_errors_total", "comparison": "GreaterThanThreshold", "threshold": 5, "evaluation_periods": 5, "period_seconds": 60, "runbook": "bad-deployment"},
    {"name": "api-latency-budget", "metric": "api_request_duration_ms", "comparison": "GreaterThanThreshold", "threshold": 1000, "evaluation_periods": 5, "period_seconds": 60, "runbook": "bad-deployment"},
    {"name": "stale-data", "metric": "dataset_age_seconds", "comparison": "GreaterThanThreshold", "threshold": 691200, "evaluation_periods": 2, "period_seconds": 3600, "runbook": "stale-dataset"},
    {"name": "pipeline-failure", "metric": "pipeline_failures_total", "comparison": "GreaterThanThreshold", "threshold": 0, "evaluation_periods": 1, "period_seconds": 300, "runbook": "ingestion-failure"},
    {"name": "reconciliation-mismatch", "metric": "reconciliation_mismatch_count", "comparison": "GreaterThanThreshold", "threshold": 0, "evaluation_periods": 1, "period_seconds": 300, "runbook": "migration-failure"},
    {"name": "dlq-messages", "metric": "dlq_depth", "comparison": "GreaterThanThreshold", "threshold": 0, "evaluation_periods": 1, "period_seconds": 60, "runbook": "dlq-replay"},
    {"name": "queue-backlog", "metric": "queue_oldest_message_age_seconds", "comparison": "GreaterThanThreshold", "threshold": 900, "evaluation_periods": 3, "period_seconds": 60, "runbook": "queue-backlog"},
    {"name": "conversion-gap-increase", "metric": "conversion_gap_count", "comparison": "GreaterThanThreshold", "threshold": 432, "evaluation_periods": 1, "period_seconds": 3600, "runbook": "stale-dataset"},
    {"name": "programme-coverage-decrease", "metric": "programme_coverage_ratio", "comparison": "LessThanThreshold", "threshold": 0.44, "evaluation_periods": 1, "period_seconds": 3600, "runbook": "stale-dataset"},
    {"name": "geography-coverage-decrease", "metric": "geography_coverage_ratio", "comparison": "LessThanThreshold", "threshold": 0.34, "evaluation_periods": 1, "period_seconds": 3600, "runbook": "stale-dataset"},
    {"name": "cost-threshold", "metric": "estimated_cost_usd", "comparison": "GreaterThanThreshold", "threshold": 500, "evaluation_periods": 1, "period_seconds": 86400, "runbook": "cost-spike"},
    {"name": "rds-cpu", "metric": "aws_rds_cpu_utilization", "comparison": "GreaterThanThreshold", "threshold": 80, "evaluation_periods": 5, "period_seconds": 60, "runbook": "rds-outage"},
    {"name": "rds-connections", "metric": "aws_rds_database_connections", "comparison": "GreaterThanThreshold", "threshold": 80, "evaluation_periods": 5, "period_seconds": 60, "runbook": "rds-outage"},
    {"name": "rds-storage", "metric": "aws_rds_free_storage_bytes", "comparison": "LessThanThreshold", "threshold": 10737418240, "evaluation_periods": 3, "period_seconds": 300, "runbook": "rds-outage"}
  ]
}
